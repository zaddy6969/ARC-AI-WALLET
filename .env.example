# Wallet
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id
NEXT_PUBLIC_SITE_URL=https://arc-ai-wallet.vercel.app

# Arc environment. Keep testnet until the official public mainnet endpoints are published and verified.
NEXT_PUBLIC_ARC_NETWORK=testnet

# Arc Testnet
NEXT_PUBLIC_ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.network
NEXT_PUBLIC_ARC_TESTNET_WS_URL=wss://rpc.testnet.arc.network
NEXT_PUBLIC_ARC_RPC_URL=https://rpc.testnet.arc.network
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.network
NEXT_PUBLIC_ARC_TESTNET_USDC_ADDRESS=0x3600000000000000000000000000000000000000
NEXT_PUBLIC_ARC_TESTNET_EURC_ADDRESS=0x89B50855Aa3bE2F677cD6303Cec089B5F319D72a
NEXT_PUBLIC_ARC_TESTNET_CIRBTC_ADDRESS=0xf0C4a4CE82A5746AbAAd9425360Ab04fbBA432BF
ARC_TESTNET_PRIVATE_KEY=

# Arc Mainnet readiness
# Arc Mainnet chain ID is 5042. Do not invent endpoint or contract values.
# To activate later: set NEXT_PUBLIC_ARC_NETWORK=mainnet, fill the official values below,
# verify /api/arc-status reports chainId 5042, then set NEXT_PUBLIC_ARC_MAINNET_ENABLED=true.
NEXT_PUBLIC_ARC_MAINNET_ENABLED=false
NEXT_PUBLIC_ARC_MAINNET_RPC_URL=
ARC_MAINNET_RPC_URL=
NEXT_PUBLIC_ARC_MAINNET_WS_URL=
NEXT_PUBLIC_ARC_MAINNET_EXPLORER_URL=
NEXT_PUBLIC_ARC_MAINNET_USDC_ADDRESS=0x3600000000000000000000000000000000000000
NEXT_PUBLIC_ARC_MAINNET_EURC_ADDRESS=
NEXT_PUBLIC_ARC_MAINNET_CIRBTC_ADDRESS=
ARC_MAINNET_PRIVATE_KEY=
NEXT_PUBLIC_ARC_MAINNET_ASSISTANT_CONTRACT_ADDRESS=

# Circle App Kit mainnet identifiers. Keep blank until Circle publishes/supports them.
NEXT_PUBLIC_ARC_MAINNET_APP_KIT_CHAIN=
NEXT_PUBLIC_ARC_MAINNET_APP_KIT_MODULE_KEY=
NEXT_PUBLIC_ETHEREUM_MAINNET_APP_KIT_CHAIN=
NEXT_PUBLIC_ETHEREUM_MAINNET_APP_KIT_MODULE_KEY=
NEXT_PUBLIC_BASE_MAINNET_APP_KIT_CHAIN=
NEXT_PUBLIC_BASE_MAINNET_APP_KIT_MODULE_KEY=

# Optional source-chain RPC overrides
NEXT_PUBLIC_ETHEREUM_MAINNET_RPC_URL=https://ethereum-rpc.publicnode.com
NEXT_PUBLIC_BASE_MAINNET_RPC_URL=https://mainnet.base.org
NEXT_PUBLIC_ETHEREUM_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Circle App Kit
KIT_KEY=your_circle_app_kit_key
VITE_KIT_KEY=your_circle_app_kit_key

# AI
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-5.4-mini
